"""Test: charge and mass conservation for Bio-Diffusion module."""

import sys, os
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import numpy as np
from core.config_loader import load_config
from network.graph import Graph
from network.bio_diffusion import BioDiffusion


def main():
    cfg = load_config("config.yaml")
    graph = Graph(cfg["network"]["N"],
                  cfg["network"]["p_edge"],
                  cfg["network"]["seed"])

    bio = BioDiffusion(graph, cfg["bio_diffusion"]["ions"],
                       eps=cfg["bio_diffusion"]["eps"],
                       F_RT=cfg["bio_diffusion"]["F_RT"],
                       dt=cfg["bio_diffusion"]["dt"])

    Q0 = bio.total_charge()
    M0 = bio.total_mass()

    print(f"Bio-Diffusion v0.1 — Conservation Test")
    print(f"Graph: {bio.N} nodes, {len(bio.edges)} edges")
    print(f"Ions: {bio.names}")
    print(f"Initial charge: {Q0:.15e}")
    print(f"Initial mass:   {M0}")
    print()

    steps = cfg["bio_diffusion"]["steps"]
    for step in range(steps):
        bio.step()
        if step % 500 == 0 or step == steps - 1:
            Q = bio.total_charge()
            M = bio.total_mass()
            dM = np.abs(M - M0) / np.abs(M0) * 100
            print(f"Step {step:4d}: |Q|={abs(Q):.2e}, "
                  f"drift_M=[{dM[0]:.2e},{dM[1]:.2e},{dM[2]:.2e}]%, "
                  c_range=[{bio.c.min():.3f}..{bio.c.max():.3f}]")

    print()
    print(f"=== RESULTS ===")
    print(f"Final charge:   {bio.total_charge():.15e}")
    print(f"Final |Q|:       {abs(bio.total_charge()):.2e}")
    print(f"Mass drift:      {np.abs(bio.total_mass() - M0) / np.abs(M0) * 100}")
    print(f"Conc. range:     {bio.c.min():.4f} .. {bio.c.max():.4f}")
    print(f"Negative conc.:  {(bio.c < 0).sum()}")


if __name__ == "__main__":
    main()

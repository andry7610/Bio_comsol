"""Bio-Diffusion module for GAK-WaveCAD.
Nernst-Planck-Poisson on graph topologies.

v0.1: dimensionless test — charge and mass conservation verified.
Physical calibration planned for v0.2.
"""

import numpy as np


class BioDiffusion:
    def __init__(self, graph, ions_config, eps=1.0, F_RT=1.0, dt=1e-4):
        """
        Args:
            graph: GAK-WaveCAD Graph instance (must have .N, .adj, .laplacian, .edges)
            ions_config: list of {"name", "D", "z", "c0"}
            eps: dielectric permittivity (dimensionless in v0.1)
            F_RT: F/(R*T) — dimensionless in v0.1
            dt: time step (dimensionless in v0.1)
        """
        self.N = graph.N
        self.adj = graph.adj
        self.L = graph.laplacian
        self.edges = graph.edges  # list of (i, j, weight)
        self.eps = eps
        self.F_RT = F_RT
        self.dt = dt

        self.D = np.array([ion["D"] for ion in ions_config])
        self.z = np.array([ion["z"] for ion in ions_config])
        self.c0 = np.array([ion["c0"] for ion in ions_config])
        self.names = [ion["name"] for ion in ions_config]

        # Concentrations: (n_ions, N)
        # Sinusoidal perturbation for initial dynamics
        self.c = np.array([
            np.full(self.N, c0) * (1.0 + 0.01 * np.sin(np.arange(self.N) * 0.7))
            for c0 in self.c0
        ])

        # Electroneutrality: adjust last ion (anion)
        if len(self.c) >= 3 and self.z[-1] < 0:
            self.c[-1] = sum(
                self.c[k] for k in range(len(self.c) - 1)
                if self.z[k] > 0
            )

        self.phi = np.zeros(self.N)

    def compute_charge_density(self):
        """ρ = Σ z_i c_i"""
        rho = np.zeros(self.N)
        for k in range(len(self.c)):
            rho += self.z[k] * self.c[k]
        return rho

    def solve_poisson(self):
        """L φ = -ρ/ε (regularized)"""
        rho = self.compute_charge_density()
        L_reg = self.L + 1e-8 * np.eye(self.N)
        self.phi = -np.linalg.solve(L_reg, rho / self.eps)
        self.phi -= np.mean(self.phi)

    def step(self):
        """One Euler step: edge-based Nernst-Planck fluxes."""
        self.solve_poisson()

        dc = np.zeros_like(self.c)

        for (i, j, w) in self.edges:
            dphi = self.phi[j] - self.phi[i]
            for k in range(len(self.c)):
                ci = self.c[k, i]
                cj = self.c[k, j]
                c_bar = 0.5 * (ci + cj)

                # Diffusion: D * (c_j - c_i)
                J_diff = self.D[k] * (cj - ci)

                # Migration: D * z * F/RT * c_bar * (phi_j - phi_i)
                J_migr = self.D[k] * self.z[k] * self.F_RT * c_bar * dphi

                J = w * (J_diff + J_migr)
                dc[k, i] += J
                dc[k, j] -= J

        self.c += self.dt * dc

    def total_charge(self):
        """Σ z_i Σ_j c_ij"""
        return sum(self.z[k] * np.sum(self.c[k]) for k in range(len(self.c)))

    def total_mass(self):
        """Per-ion total concentration"""
        return np.array([np.sum(self.c[k]) for k in range(len(self.c))])
